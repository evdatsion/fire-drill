{
  "name": "fire-drill",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint sim tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/",
    "bench": "npm run build && node dist/sim/src/bench.js",
    "render": "node bench/render.mjs",
    "demo": "npm --prefix demo install --no-fund --no-audit && npm --prefix demo run dev",
    "demo:build": "npm --prefix demo install --no-fund --no-audit && npm --prefix demo run build",
    "package-zip": "node scripts/build-package-zip.mjs",
    "words": "node proposal/count-words.mjs proposal/proposal.md"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "20.19.43",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
